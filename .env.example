# -----------------------------------------------------------------------------
# TheWork STUDIO — Environment Variables
# Copy this file to .env and fill in your values.
# -----------------------------------------------------------------------------

# PostgreSQL Connection String (Neon or Supabase)
# For Neon, grab this from your Neon Console (pooled connection recommended):
# e.g., postgresql://user:pass@ep-cool-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/team_planner?schema=public"

# Auth.js / NextAuth Configuration
# Generate a secret using: `openssl rand -base64 32` or `npx auth secret`
NEXTAUTH_SECRET="replace-with-a-secure-random-32-byte-secret"
AUTH_SECRET="replace-with-a-secure-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional Google OAuth Credentials (for Google Sign-In)
# Leave blank or omit if testing solely with email + password
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend Email Configuration (Free tier: 3,000 emails/mo, 100/day)
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY="re_123456789_abcdefg"
# For development before domain verification, use 'onboarding@resend.dev'
# After domain verification, use your verified domain address:
EMAIL_FROM="TheWork STUDIO <notifications@yourdomain.com>"

# Cron Dispatcher Security Token
# Protects /api/cron/dispatch-reminders from unauthorized calls.
# Pass this in the 'Authorization: Bearer <CRON_SECRET>' header.
CRON_SECRET="replace-with-a-secure-random-token-for-cron"

# Application Base URL (used in email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
